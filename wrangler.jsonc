{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workers-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Workers Logs: indexes the JSON log lines from src/log.ts.
  "observability": { "enabled": true },

  // Files in ./public are served straight from Cloudflare's edge; anything
  // that doesn't match a file falls through to the Worker.
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workers-starter-db",
      // No database_id: `wrangler deploy` finds the database by name, or creates
      // it on the first deploy. Add the id here later if you want it pinned.
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret config. Secrets go in `wrangler secret put NAME` (and .dev.vars locally).
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "",
    "MAX_BODY_BYTES": "1000000"
  }
}
